package __PACKAGE__;

import android.app.DownloadManager;
import android.content.ContentResolver;
import android.content.ContentValues;
import android.content.Context;
import android.content.Intent;
import android.net.Uri;
import android.os.Build;
import android.os.Bundle;
import android.os.Environment;
import android.provider.MediaStore;
import android.util.Base64;
import android.webkit.CookieManager;
import android.webkit.DownloadListener;
import android.webkit.JavascriptInterface;
import android.webkit.URLUtil;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.widget.Toast;
import com.getcapacitor.BridgeActivity;
import java.io.File;
import java.io.FileOutputStream;
import java.io.OutputStream;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;

/**
 * "Full browser mode": gives the WebView the things a normal browser has.
 * - server downloads (links, Content-Disposition) via DownloadManager
 * - saving files to Downloads/Documents on Android 10+ via MediaStore
 * - third-party cookies (iframes, logins), autoplay, DOM storage
 * Generated by the builder. If this file ever fails to compile the build
 * automatically retries with the stock MainActivity.
 */
public class MainActivity extends BridgeActivity {

    private final Map<String, OutputStream> streams = new ConcurrentHashMap<String, OutputStream>();
    private final Map<String, String> results = new ConcurrentHashMap<String, String>();

    @Override
    public void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        try {
            WebView wv = getBridge().getWebView();
            WebSettings s = wv.getSettings();
            s.setJavaScriptEnabled(true);
            s.setDomStorageEnabled(true);
            s.setDatabaseEnabled(true);
            s.setMediaPlaybackRequiresUserGesture(false);
            CookieManager.getInstance().setAcceptThirdPartyCookies(wv, true);
            wv.addJavascriptInterface(new NativeFiles(), "Android");
            wv.setDownloadListener(new DownloadListener() {
                @Override
                public void onDownloadStart(String url, String userAgent, String contentDisposition, String mimetype, long contentLength) {
                    if (url == null || url.startsWith("blob:") || url.startsWith("data:")) {
                        return; // handled in JavaScript by native-bridge-pro.js
                    }
                    String name = URLUtil.guessFileName(url, contentDisposition, mimetype);
                    boolean ok = enqueueDownload(url, userAgent, name, mimetype);
                    Toast.makeText(getApplicationContext(), ok ? "Downloading " + name : "Download failed", Toast.LENGTH_SHORT).show();
                }
            });
        } catch (Exception e) {
            // keep the app working even if a setting is unavailable
        }
    }

    private boolean enqueueDownload(String url, String userAgent, String name, String mimetype) {
        try {
            DownloadManager.Request req = new DownloadManager.Request(Uri.parse(url));
            if (mimetype != null && mimetype.length() > 0) {
                req.setMimeType(mimetype);
            }
            String cookies = CookieManager.getInstance().getCookie(url);
            if (cookies != null) {
                req.addRequestHeader("cookie", cookies);
            }
            if (userAgent != null) {
                req.addRequestHeader("User-Agent", userAgent);
            }
            req.setTitle(name);
            req.setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED);
            req.setDestinationInExternalPublicDir(Environment.DIRECTORY_DOWNLOADS, name);
            DownloadManager dm = (DownloadManager) getSystemService(Context.DOWNLOAD_SERVICE);
            dm.enqueue(req);
            return true;
        } catch (Exception e) {
            return false;
        }
    }

    private File uniqueFile(File dir, String name) {
        File f = new File(dir, name);
        String base = name;
        String ext = "";
        int dot = name.lastIndexOf('.');
        if (dot > 0) {
            base = name.substring(0, dot);
            ext = name.substring(dot);
        }
        int i = 1;
        while (f.exists()) {
            f = new File(dir, base + " (" + i + ")" + ext);
            i++;
        }
        return f;
    }

    /** Exposed to JavaScript as window.Android */
    public class NativeFiles {

        @JavascriptInterface
        public String beginFile(String name, String mime, String location) {
            try {
                String id = UUID.randomUUID().toString();
                String safe = (name == null || name.length() == 0) ? "file" : name;
                String type = (mime == null || mime.length() == 0) ? "application/octet-stream" : mime;
                boolean docs = "documents".equals(location);
                OutputStream os;
                String shown;
                if ("private".equals(location)) {
                    File dir = new File(getExternalFilesDir(null), "files");
                    dir.mkdirs();
                    File f = uniqueFile(dir, safe);
                    os = new FileOutputStream(f);
                    shown = f.getAbsolutePath();
                } else if (Build.VERSION.SDK_INT >= 29) {
                    ContentResolver cr = getContentResolver();
                    ContentValues v = new ContentValues();
                    v.put(MediaStore.MediaColumns.DISPLAY_NAME, safe);
                    v.put(MediaStore.MediaColumns.MIME_TYPE, type);
                    v.put(MediaStore.MediaColumns.RELATIVE_PATH, docs ? Environment.DIRECTORY_DOCUMENTS : Environment.DIRECTORY_DOWNLOADS);
                    Uri collection = docs ? MediaStore.Files.getContentUri("external") : MediaStore.Downloads.EXTERNAL_CONTENT_URI;
                    Uri uri = cr.insert(collection, v);
                    if (uri == null) {
                        return "";
                    }
                    os = cr.openOutputStream(uri);
                    if (os == null) {
                        return "";
                    }
                    shown = uri.toString();
                } else {
                    File dir = Environment.getExternalStoragePublicDirectory(docs ? Environment.DIRECTORY_DOCUMENTS : Environment.DIRECTORY_DOWNLOADS);
                    dir.mkdirs();
                    File f = uniqueFile(dir, safe);
                    os = new FileOutputStream(f);
                    shown = f.getAbsolutePath();
                }
                streams.put(id, os);
                results.put(id, shown);
                return id;
            } catch (Exception e) {
                return "";
            }
        }

        @JavascriptInterface
        public boolean appendFile(String id, String base64) {
            try {
                OutputStream os = streams.get(id);
                if (os == null) {
                    return false;
                }
                os.write(Base64.decode(base64, Base64.DEFAULT));
                return true;
            } catch (Exception e) {
                return false;
            }
        }

        @JavascriptInterface
        public String endFile(String id) {
            try {
                OutputStream os = streams.remove(id);
                if (os != null) {
                    os.flush();
                    os.close();
                }
                String r = results.remove(id);
                return r == null ? "" : r;
            } catch (Exception e) {
                return "";
            }
        }

        @JavascriptInterface
        public String saveFile(String base64, String name, String mime, String location) {
            String id = beginFile(name, mime, location);
            if (id.length() == 0) {
                return "";
            }
            if (!appendFile(id, base64)) {
                endFile(id);
                return "";
            }
            return endFile(id);
        }

        @JavascriptInterface
        public boolean downloadUrl(String url, String name) {
            return enqueueDownload(url, null, name, null);
        }

        @JavascriptInterface
        public boolean openFile(String uri, String mime) {
            try {
                Uri u = uri.startsWith("/") ? Uri.fromFile(new File(uri)) : Uri.parse(uri);
                Intent i = new Intent(Intent.ACTION_VIEW);
                i.setDataAndType(u, (mime == null || mime.length() == 0) ? "*/*" : mime);
                i.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_ACTIVITY_NEW_TASK);
                startActivity(i);
                return true;
            } catch (Exception e) {
                return false;
            }
        }

        @JavascriptInterface
        public void exitApp() {
            runOnUiThread(new Runnable() {
                @Override
                public void run() {
                    finishAffinity();
                }
            });
        }

        @JavascriptInterface
        public void minimize() {
            runOnUiThread(new Runnable() {
                @Override
                public void run() {
                    moveTaskToBack(true);
                }
            });
        }
    }
}
